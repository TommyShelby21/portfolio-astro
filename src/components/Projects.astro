---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="projects">
    <div class="container">
        <h2 class="section-title" data-aos="fade-up">Vybrané projekty</h2>

        {projects.map((project, i) => <ProjectCard {...project} index={i} />)}
    </div>
</section>
