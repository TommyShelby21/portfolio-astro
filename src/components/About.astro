---
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="about">

	<div class="container">

		<h2 class="section-title" data-aos="fade-up">
			{t("about.title")}
		</h2>


		<div class="content card" data-aos="fade-up" data-aos-delay="150">

			<p>
				{t("about.p1")}
			</p>

			<p>
				{t("about.p2")}
			</p>

			<p>
				{t("about.p3")}
			</p>

		</div>

	</div>

</section>


<style>

.content {

	max-width:800px;

	display:flex;

	flex-direction:column;

	gap:20px;

}


</style>