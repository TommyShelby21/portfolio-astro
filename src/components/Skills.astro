---
import { skills } from "../data/skills";
---


<section id="skills">

	<div class="container">

		<h2>
			Technologie
		</h2>


		<div class="grid">

			{
				skills.map(group => (

					<div class="card">

						<h3>
							{group.category}
						</h3>


						<div class="tags">

							{
								group.items.map(skill => (

									<span>
										{skill}
									</span>

								))
							}

						</div>


					</div>

				))
			}

		</div>


	</div>

</section>



<style>

.grid {

	display:grid;

	grid-template-columns:
	repeat(auto-fit,minmax(250px,1fr));

	gap:25px;

}


h3 {

	margin-bottom:20px;

	color:var(--primary);

}


.tags {

	display:flex;

	flex-wrap:wrap;

	gap:10px;

}


.tags span {

	padding:8px 14px;

	background:rgba(56,189,248,.1);

	border-radius:999px;

	font-size:.9rem;

	color:var(--text-secondary);

	border:1px solid var(--border);

}


</style>