---

<nav id="navbar">
	<div class="container nav-container">

		<a href="/" class="logo">
			Tomáš <span class="gradient-text">Osička</span>
		</a>


		<div class="links">
			<a href="#about">O mně</a>
			<a href="#skills">Skills</a>
			<a href="#projects">Projekty</a>
			<a href="#contact">Kontakt</a>
		</div>

	</div>
</nav>


<script>
	const nav = document.getElementById("navbar");

	const onScroll = () => {
		nav?.classList.toggle("scrolled", window.scrollY > 20);
	};

	window.addEventListener("scroll", onScroll, { passive: true });
	onScroll();

	// Highlight link of the section currently in view
	const links = document.querySelectorAll<HTMLAnchorElement>(".links a");

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;

				links.forEach((link) => {
					link.classList.toggle(
						"active",
						link.getAttribute("href") === `#${entry.target.id}`,
					);
				});
			});
		},
		{ rootMargin: "-45% 0px -50% 0px" },
	);

	document
		.querySelectorAll("section[id]")
		.forEach((section) => observer.observe(section));
</script>


<style>
nav {
	position: fixed;
	top: 0;
	width: 100%;
	z-index: 100;

	background: rgba(15,23,42,0.4);
	backdrop-filter: blur(12px);

	border-bottom: 1px solid transparent;

	transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;

	animation: slideDown 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}


nav.scrolled {
	background: rgba(15,23,42,0.85);
	border-bottom-color: var(--border);
	box-shadow: 0 10px 30px -15px rgba(0,0,0,0.6);
}


.nav-container {
	height: 80px;

	display: flex;
	align-items: center;
	justify-content: space-between;

	transition: height 0.3s;
}


nav.scrolled .nav-container {
	height: 64px;
}


.logo {
	font-weight: 700;
	font-size: 1.2rem;
	color: var(--text);
}


.links {
	display: flex;
	gap: 30px;
}


.links a {
	position: relative;
	color: var(--text-secondary);
	transition: color .2s;
}


.links a::after {
	content: "";
	position: absolute;
	left: 0;
	bottom: -4px;

	width: 100%;
	height: 2px;

	border-radius: 999px;
	background: var(--gradient);

	transform: scaleX(0);
	transform-origin: left;
	transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1);
}


.links a:hover,
.links a.active {
	color: var(--primary);
}


.links a:hover::after,
.links a.active::after {
	transform: scaleX(1);
}


@keyframes slideDown {
	from {
		transform: translateY(-100%);
	}

	to {
		transform: none;
	}
}


@media(max-width:700px){

	.links {
		display:none;
	}

}

</style>
