---
import { getLang, homePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const otherLang = lang === "cs" ? "en" : "cs";
---

<nav id="navbar">
	<div class="container nav-container">

		<a href={homePath(lang)} class="logo">
			Tomáš <span class="gradient-text">Osička</span>
		</a>


		<div class="right">
			<div class="links">
				<a href="#about">{t("nav.about")}</a>
				<a href="#skills">{t("nav.skills")}</a>
				<a href="#projects">{t("nav.projects")}</a>
				<a href="#contact">{t("nav.contact")}</a>
			</div>

			<a
				href={homePath(otherLang)}
				class="lang-switch"
				hreflang={otherLang}
				aria-label={t("nav.switch")}
				title={t("nav.switch")}
			>
				<span class:list={{ current: lang === "cs" }}>CS</span>
				<span class:list={{ current: lang === "en" }}>EN</span>
			</a>
		</div>

	</div>
</nav>


<script>
	const nav = document.getElementById("navbar");

	const onScroll = () => {
		nav?.classList.toggle("scrolled", window.scrollY > 20);
	};

	window.addEventListener("scroll", onScroll, { passive: true });
	onScroll();

	// Highlight link of the section currently in view
	const links = document.querySelectorAll<HTMLAnchorElement>(".links a");

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;

				links.forEach((link) => {
					link.classList.toggle(
						"active",
						link.getAttribute("href") === `#${entry.target.id}`,
					);
				});
			});
		},
		{ rootMargin: "-45% 0px -50% 0px" },
	);

	document
		.querySelectorAll("section[id]")
		.forEach((section) => observer.observe(section));

	// Keep the current section when switching language
	document
		.querySelector<HTMLAnchorElement>(".lang-switch")
		?.addEventListener("click", (event) => {
			const active = document.querySelector(".links a.active");
			const hash = active?.getAttribute("href");

			if (!hash) return;

			event.preventDefault();
			window.location.href =
				(event.currentTarget as HTMLAnchorElement).pathname + hash;
		});
</script>


<style>
nav {
	position: fixed;
	top: 0;
	width: 100%;
	z-index: 100;

	background: rgba(15,23,42,0.4);
	backdrop-filter: blur(12px);

	border-bottom: 1px solid transparent;

	transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;

	animation: slideDown 0.7s cubic-bezier(0.22, 1, 0.36, 1);
}


nav.scrolled {
	background: rgba(15,23,42,0.85);
	border-bottom-color: var(--border);
	box-shadow: 0 10px 30px -15px rgba(0,0,0,0.6);
}


.nav-container {
	height: 80px;

	display: flex;
	align-items: center;
	justify-content: space-between;

	transition: height 0.3s;
}


nav.scrolled .nav-container {
	height: 64px;
}


.logo {
	font-weight: 700;
	font-size: 1.2rem;
	color: var(--text);
}


.right {
	display: flex;
	align-items: center;
	gap: 30px;
}


.links {
	display: flex;
	gap: 30px;
}


.lang-switch {
	position: relative;

	display: flex;

	padding: 3px;

	border: 1px solid var(--border);
	border-radius: 999px;

	font-size: .8rem;
	font-weight: 600;

	transition: border-color .25s;
}


.lang-switch:hover {
	border-color: var(--primary);
}


.lang-switch span {
	padding: 4px 10px;

	border-radius: 999px;

	color: var(--text-secondary);

	transition: background .25s, color .25s;
}


.lang-switch span.current {
	background: var(--gradient);
	color: #020617;
}


.lang-switch:hover span:not(.current) {
	color: var(--text);
}


.links a {
	position: relative;
	color: var(--text-secondary);
	transition: color .2s;
}


.links a::after {
	content: "";
	position: absolute;
	left: 0;
	bottom: -4px;

	width: 100%;
	height: 2px;

	border-radius: 999px;
	background: var(--gradient);

	transform: scaleX(0);
	transform-origin: left;
	transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1);
}


.links a:hover,
.links a.active {
	color: var(--primary);
}


.links a:hover::after,
.links a.active::after {
	transform: scaleX(1);
}


@keyframes slideDown {
	from {
		transform: translateY(-100%);
	}

	to {
		transform: none;
	}
}


@media(max-width:700px){

	.links {
		display:none;
	}

}

</style>
