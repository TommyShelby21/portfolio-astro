---
import { Image } from "astro:assets";
import builder from "../assets/hero-builder.png";
---

<section class="hero">
    <div class="container hero-grid">
        <div class="hero-text">
            <p class="hello reveal" style="--i: 0">Ahoj, jsem</p>

            <h1 class="reveal" style="--i: 1">
                <span class="gradient-text">Tomáš Osička</span>
            </h1>

            <h2 class="reveal" style="--i: 2">Full Stack Developer</h2>

            <p class="description reveal" style="--i: 3">
                Rád stavím moderní webové aplikace pomocí Vue a Django.
            </p>

            <div class="buttons reveal" style="--i: 4">
                <a
                    class="button"
                    href="https://github.com/TommyShelby21"
                    target="_blank"
                >
                    GitHub
                </a>

                <a class="outline" href="#contact"> Kontakt </a>
            </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
            <div class="glow"></div>

            <div class="bubble">Stavím ti web… 🧱</div>

            <Image
                src={builder}
                alt=""
                class="builder"
                width={420}
                loading="eager"
            />
        </div>
    </div>

    <a href="#about" class="scroll-indicator" aria-label="Posunout dolů">
        <span></span>
    </a>
</section>

<style>
    .hero {
        position: relative;

        min-height: 100vh;

        display: flex;
        align-items: center;

        padding-top: 80px;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        align-items: center;
        gap: 40px;
    }

    .hero-visual {
        position: relative;

        display: flex;
        justify-content: center;

        opacity: 0;
        animation: popIn 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.6s forwards;
    }

    .glow {
        position: absolute;
        inset: 10%;

        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(56, 189, 248, 0.35),
            transparent 70%
        );

        filter: blur(30px);

        animation: pulse 4s ease-in-out infinite;
    }

    .builder {
        position: relative;

        width: 100%;
        max-width: 420px;
        height: auto;

        filter: drop-shadow(0 25px 35px rgba(0, 0, 0, 0.45));

        animation: bob 4s ease-in-out infinite;

        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .hero-visual:hover .builder {
        transform: rotate(-4deg) scale(1.04);
    }

    .bubble {
        position: absolute;
        top: 0;
        right: 0;
        z-index: 1;

        padding: 10px 16px;

        background: var(--text);
        color: #020617;

        border-radius: 16px 16px 16px 4px;

        font-weight: 600;
        font-size: 0.95rem;
        white-space: nowrap;

        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);

        opacity: 0;
        transform-origin: bottom left;
        animation:
            bubbleIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s forwards,
            wiggle 5s ease-in-out 2.5s infinite;
    }

    @keyframes popIn {
        from {
            opacity: 0;
            transform: translateY(40px) scale(0.85);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes bob {
        0%,
        100% {
            translate: 0 0;
        }

        50% {
            translate: 0 -14px;
        }
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.6;
            scale: 1;
        }

        50% {
            opacity: 1;
            scale: 1.08;
        }
    }

    @keyframes bubbleIn {
        from {
            opacity: 0;
            transform: scale(0.3);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes wiggle {
        0%,
        90%,
        100% {
            rotate: 0deg;
        }

        93% {
            rotate: -6deg;
        }

        96% {
            rotate: 5deg;
        }
    }

    @media (max-width: 860px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }

        .hero-visual {
            order: -1;
            max-width: 280px;
            margin: 0 auto;
        }

        .bubble {
            font-size: 0.8rem;
            right: -20px;
        }
    }

    .hello {
        color: var(--primary);

        font-size: 1.2rem;

        margin-bottom: 15px;
    }

    h1 {
        margin-bottom: 10px;
    }

    h2 {
        color: var(--text-secondary);

        font-weight: 500;

        font-size: clamp(1.5rem, 4vw, 2.5rem);
    }

    .description {
        max-width: 650px;

        margin-top: 30px;
    }

    .buttons {
        display: flex;

        gap: 20px;

        margin-top: 40px;
    }

    .outline {
        padding: 12px 24px;

        border: 1px solid var(--border);

        border-radius: 999px;

        color: var(--text);

        transition: 0.25s;
    }

    .outline:hover {
        border-color: var(--primary);

        color: var(--primary);

        transform: translateY(-3px);
    }

    .reveal {
        opacity: 0;

        animation: fadeUp 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        animation-delay: calc(var(--i) * 120ms + 100ms);
    }

    @keyframes fadeUp {
        from {
            opacity: 0;

            transform: translateY(30px);
        }

        to {
            opacity: 1;

            transform: none;
        }
    }

    .scroll-indicator {
        position: absolute;
        bottom: 40px;
        left: 50%;

        width: 26px;
        height: 42px;

        border: 2px solid var(--border);
        border-radius: 999px;

        translate: -50% 0;

        opacity: 0;
        animation: fadeIn 1s ease 1.2s forwards;

        transition: border-color 0.25s;
    }

    .scroll-indicator:hover {
        border-color: var(--primary);
    }

    .scroll-indicator span {
        position: absolute;
        top: 8px;
        left: 50%;

        width: 4px;
        height: 8px;

        margin-left: -2px;

        border-radius: 999px;
        background: var(--primary);

        animation: wheel 1.8s ease-in-out infinite;
    }

    @keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    @keyframes wheel {
        0% {
            opacity: 1;
            transform: translateY(0);
        }

        100% {
            opacity: 0;
            transform: translateY(14px);
        }
    }

    @media (max-height: 600px) {
        .scroll-indicator {
            display: none;
        }
    }
</style>
