---
interface Props {
    title: string;
    description: string;
    image: string;
    technologies: string[];
    github: string;
    demo: string;
    index?: number;
}

const { title, description, image, technologies, github, demo, index = 0 } =
    Astro.props;
---

<div
    class="card project"
    data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
>
    <div class="image">
        <img src={image} alt={title} loading="lazy" />
    </div>

    <div>
        <h3>
            {title}
        </h3>

        <p>
            {description}
        </p>

        <div class="tags">
            {technologies.map((tech) => <span>{tech}</span>)}
        </div>

        <div class="links">
            <a href={github} target="_blank"> GitHub </a>

            <a href={demo}> Demo </a>
        </div>
    </div>
</div>

<style>
    .project {
        display: grid;

        grid-template-columns: 300px 1fr;

        gap: 30px;

        margin-bottom: 30px;
    }

    .image {
        height: 200px;

        overflow: hidden;

        border-radius: 12px;

        background: #020617;
    }

    img {
        width: 100%;

        height: 100%;

        object-fit: cover;

        transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .project:hover img {
        transform: scale(1.06);
    }

    h3 {
        font-size: 1.5rem;

        margin-bottom: 10px;
    }

    .tags {
        display: flex;

        flex-wrap: wrap;

        gap: 8px;

        margin: 20px 0;
    }

    .tags span {
        padding: 6px 12px;

        border-radius: 999px;

        border: 1px solid var(--border);

        font-size: 0.85rem;

        color: var(--text-secondary);
    }

    .links {
        display: flex;

        gap: 20px;
    }

    .links a {
        color: var(--primary);

        transition: 0.2s;
    }

    .links a:hover {
        color: var(--text);
    }

    @media (max-width: 700px) {
        .project {
            grid-template-columns: 1fr;
        }
    }
</style>
